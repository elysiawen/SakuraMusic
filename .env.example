# ---------------------------------------------------------------------------
# Sakura Music 环境变量模板
# 复制为 gateway/.env 后按需修改（gateway 启动时会自动读取 gateway/.env）
# ---------------------------------------------------------------------------

# 网关监听地址
PORT=8787
HOST=127.0.0.1

# 已有的 PostgreSQL 连接串（必填）
DATABASE_URL=postgres://user:password@127.0.0.1:5432/sakura_music

# TLS 策略：auto（默认）＝ 内网/本机地址不加密、外网地址加密；
# 若按 auto 启用了 TLS 但服务端不支持，网关会自动回退到非加密连接并打印提示。
# 需要强制时填 true / false。
DB_SSL=auto

# 凭据加密主密钥：32 字节 base64。
# 留空时网关会自动生成并写入 gateway/.data/credential.key（换机请迁移该文件，
# 否则已加密入库的凭据将无法解密）。
CREDENTIAL_KEY=

# 上游服务地址（两个上游项目保持零改动，原样运行即可）
NETEASE_BASE_URL=http://127.0.0.1:3700
QQ_BASE_URL=http://127.0.0.1:8080

# QQ 音乐客户端（App）扫码登录 sidecar，见 sidecar/qq_mobile_login.py
# 该服务复用 QQMusicApi 的 venv，用 `pnpm start:sidecar` 启动
QQ_SIDECAR_BASE_URL=http://127.0.0.1:8090

# 允许携带 Cookie 的前端来源，多个用英文逗号分隔
WEB_ORIGIN=http://localhost:5173

# 生产环境走 HTTPS 时设为 true，让会话 Cookie 带上 Secure
COOKIE_SECURE=false

# 是否开放注册
ALLOW_REGISTER=true

# 会话有效期（天）
SESSION_DAYS=30

# QQ 音乐音频 CDN 域名（一般无需修改）
QQ_STREAM_HOST=https://ws.stream.qqmusic.qq.com/

# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=15000

{
  "name": "@sakura/netease-upstream",
  "version": "0.1.0",
  "private": true,
  "description": "网易云上游（本仓库自带）：钉住发布版 SDK 的薄 HTTP 层，网关只按固定的 18 个接口调用它",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
